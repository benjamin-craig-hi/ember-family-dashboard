#!/usr/bin/env bash
# After a deploy (git pull), reload the kiosk browser.
# Runs detached with a short delay so the backend service restart
# (which happens right after `git pull` in the deploy command) completes first.
set -u

TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
SCRIPT="$TOP/scripts/reload-kiosk.sh"
[ -x "$SCRIPT" ] || exit 0

setsid bash -c "sleep 5; exec '$SCRIPT'" >/dev/null 2>&1 < /dev/null &

exit 0
