# OLLAMA_HOST — where a LOCAL Ollama lives (used only when the dashboard's
# "AI brain" provider is set to "local"). Defaults to localhost. Point this
# at a GPU workstation on your LAN to offload a local model.
OLLAMA_HOST=http://localhost:11434

# OLLAMA_MODEL — the local Ollama model to use (provider = "local").
OLLAMA_MODEL=qwen3:8b-q8_0

# OLLAMA_API_KEY — API key for Ollama Cloud (provider = "api", API provider
# = "Ollama Cloud"). Create one at https://ollama.com/settings/keys. The
# dashboard's model picker can also store this key in settings.json; this
# env var is a fallback that the ollama client reads automatically.
# OLLAMA_API_KEY=your_key_here
